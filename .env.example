# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MIN_INTERVAL_S=1

# SambaNova Cloud — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MIN_INTERVAL_S=4

# Google AI Studio (Gemini) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_INTERVAL_S=2

# Which provider plays which role in scripts/run_phase1_sweep.py —
# must be one of: groq, sambanova, gemini
CHEAP_PROVIDER=groq
EXPENSIVE_PROVIDER=sambanova

# Hard spending cap for the whole sweep, in USD. Enforced as a proactive
# stop-before-next-call guard, not a perfectly precise ceiling — see
# src/eval/budget.py for why. Free-tier usage doesn't actually charge
# anything right now; this exists as a safety net regardless.
BUDGET_USD=1.00

# Supabase — https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_KEY=